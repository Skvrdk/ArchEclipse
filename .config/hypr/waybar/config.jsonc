// KDE-style bottom panel for desktop mode (started by config/custom/desktop-mode.lua).
{
    "layer": "top",
    "position": "bottom",
    "height": 44,
    "spacing": 6,
    "margin": "0 0 0 0",
    "modules-left": ["custom/start", "wlr/taskbar"],
    "modules-right": ["tray", "pulseaudio", "clock", "custom/min", "custom/max", "custom/close"],
    "custom/start": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "qs -p ~/.config/quickshell/archeclipse ipc call bar toggleSearch"
    },
    "wlr/taskbar": {
        "format": "{icon}  {title}",
        "icon-size": 22,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize-raise",
        "ignore-list": []
    },
    "tray": { "icon-size": 20, "spacing": 8 },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pavucontrol"
    },
    // Window controls for the focused window (Hyprland has no minimize: it goes to a hidden workspace, the taskbar brings it back).
    "custom/min": {
        "format": "󰖰",
        "tooltip-format": "Minimize",
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.window.move({ workspace = \"special:min\", follow = false })'"
    },
    "custom/max": {
        "format": "󰖯",
        "tooltip-format": "Maximize",
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.window.fullscreen({ action = \"toggle\", mode = \"maximized\" })'"
    },
    "custom/close": {
        "format": "󰖭",
        "tooltip-format": "Close",
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.window.close()'"
    },
    "clock": {
        "format": "{:%H:%M  %d.%m}",
        "tooltip-format": "{:%A, %d %B %Y}"
    }
}
